# Copy this to .env.docker and fill in real values before running
# docker compose up. DATABASE_URL is intentionally NOT set here — compose
# builds it for you from POSTGRES_* below and injects it as "postgres",
# not "localhost" (see docker-compose.yml).

# --- Used by BOTH the postgres and backend services ---
POSTGRES_USER=unny_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=unny

# --- Host port mappings (change only if these ports are already taken) ---
POSTGRES_HOST_PORT=5432
APP_HOST_PORT=5000

# --- Backend runtime config ---
NODE_ENV=production
PORT=5000

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:19006

# --- AWS S3 (optional — leave blank to use the local-disk fallback) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=unny-project-reports
AWS_S3_PRESIGN_EXPIRES_SECONDS=300

# --- Firebase Admin (optional — push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Local storage fallback (only matters if AWS_* above is left blank) ---
LOCAL_STORAGE_DIR=storage/uploads
LOCAL_STORAGE_BASE_URL=http://localhost:5000
LOCAL_STORAGE_PRESIGN_EXPIRES_SECONDS=300
LOCAL_STORAGE_MAX_UPLOAD_MB=25

# --- Optional: skip re-seeding tags on every container restart ---
SKIP_SEED=false
